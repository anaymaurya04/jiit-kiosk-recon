<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe only. Board 28/31's Today tile with sample values; every field is rewritten on paint. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/today_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="#C23B4E"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:text="SESSION EXPIRED · TAP TO RECONNECT"
            android:textColor="#F0EEE9"
            android:textSize="10sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/today_cols"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/today_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="112"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:letterSpacing="0.05"
                    android:text="@string/w_next"
                    android:textColor="#A09DA6"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/today_next_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_semibold"
                    android:includeFontPadding="false"
                    android:text="2:00 PM"
                    android:textColor="#F0EEE9"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/today_next_subject"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/ibm_plex_sans_medium"
                    android:maxLines="2"
                    android:text="Foundations of Data Analytics"
                    android:textColor="#F0EEE9"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/today_next_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#4CC38A"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="2dp"
                    android:text="✓ SAFE"
                    android:textColor="#0B0B0D"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/today_att"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="21dp"
                android:layout_weight="76"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:letterSpacing="0.05"
                    android:text="@string/w_attend_short"
                    android:textColor="#A09DA6"
                    android:textSize="10sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/today_ring"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_ring_sample" />

                    <TextView
                        android:id="@+id/today_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/ibm_plex_mono_regular"
                        android:text="78"
                        android:textColor="#F0EEE9"
                        android:textSize="14sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:letterSpacing="0.05"
                    android:text="@string/w_overall"
                    android:textColor="#A09DA6"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/today_pend"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="21dp"
                android:layout_weight="70"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:letterSpacing="0.05"
                    android:text="@string/w_pending"
                    android:textColor="#A09DA6"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/today_pend_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_semibold"
                    android:includeFontPadding="false"
                    android:text="3"
                    android:textColor="#F0EEE9"
                    android:textSize="52sp" />

                <TextView
                    android:id="@+id/today_pend_missing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:letterSpacing="0.05"
                    android:text="1 MISSING"
                    android:textColor="#A09DA6"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/today_skeleton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="112"
                android:orientation="vertical">

                <View
                    android:layout_width="62dp"
                    android:layout_height="12dp"
                    android:background="@drawable/widget_skeleton_block" />

                <View
                    android:layout_width="102dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/widget_skeleton_block" />

                <View
                    android:layout_width="106dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/widget_skeleton_block" />

                <View
                    android:layout_width="52dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/widget_skeleton_block" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="21dp"
                android:background="#26262E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="21dp"
                android:layout_weight="76"
                android:orientation="vertical">

                <View
                    android:layout_width="42dp"
                    android:layout_height="12dp"
                    android:background="@drawable/widget_skeleton_block" />

                <View
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/widget_skeleton_block" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="21dp"
                android:background="#26262E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="21dp"
                android:layout_weight="70"
                android:orientation="vertical">

                <View
                    android:layout_width="42dp"
                    android:layout_height="12dp"
                    android:background="@drawable/widget_skeleton_block" />

                <View
                    android:layout_width="42dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/widget_skeleton_block" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/today_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp">

                <ImageView
                    android:id="@+id/today_state_ghost"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_ghost_moon" />

                <ImageView
                    android:id="@+id/today_state_tablet"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_vertical|start"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_ghost_tablet"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/today_state_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_semibold"
                    android:includeFontPadding="false"
                    android:text="All clear"
                    android:textColor="#F0EEE9"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/today_state_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/ibm_plex_sans_regular"
                    android:text="No more classes today. Nothing due."
                    android:textColor="#A09DA6"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/today_state_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:text="NEXT: MON 10:00 AM · SOFTWARE ENGINEERING"
                    android:textColor="#A09DA6"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/today_state_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F0EEE9"
                    android:fontFamily="@font/ibm_plex_mono_medium"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="2dp"
                    android:text="TAP TO CREATE"
                    android:textColor="#0B0B0D"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_footer_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:text="FRI 16 OCT"
                android:textColor="#A09DA6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/today_footer_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_regular"
                android:text="SYNCED 4 MIN AGO"
                android:textColor="#A09DA6"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_sample"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="#F0EEE9"
        android:fontFamily="@font/ibm_plex_mono_medium"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="SAMPLE"
        android:textColor="#0B0B0D"
        android:textSize="9sp" />
</FrameLayout>
