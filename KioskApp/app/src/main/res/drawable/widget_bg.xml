<?xml version="1.0" encoding="utf-8"?>
<!-- the mock's card: Panel on a 1dp edge, with the 3dp red accent bar down the left (design/Widget.html) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#19191D" />
            <stroke
                android:width="1dp"
                android:color="#303036" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="#D64B60" />
            <corners
                android:topLeftRadius="18dp"
                android:bottomLeftRadius="18dp" />
        </shape>
    </item>
</layer-list>
